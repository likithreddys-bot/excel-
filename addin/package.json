{
  "name": "sheet-assistant-addin",
  "version": "0.1.0",
  "private": true,
  "description": "Excel add-in: describe what you want done to a table in plain English. Rule-based, no AI, data never leaves the machine.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "golden": "python3 tools/gen_golden.py",
    "pretest": "npm run golden && python3 tools/gen_fixtures.py",
    "test": "vitest run",
    "validate": "office-addin-manifest validate manifest.xml",
    "certs": "office-addin-dev-certs install",
    "manifest": "node tools/make-manifest.mjs",
    "bench": "vite-node tools/bench.ts"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.611",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
